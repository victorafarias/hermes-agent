# Configurações de Autenticação do Hermes Web Dashboard
# Obrigatório para binds públicos (0.0.0.0) sob Traefik
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=coloque_uma_senha_forte_aqui
# Segredo HMAC de 32+ bytes para manter a sessão após restarts (gere com openssl rand -base64 32)
HERMES_DASHBOARD_BASIC_AUTH_SECRET=

# Provedores de Modelos LLM (Configure conforme sua preferência)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# Integrações de Mensageria (Opcional - Telegram, Discord, Slack, etc.)
# TELEGRAM_BOT_TOKEN=
# DISCORD_BOT_TOKEN=
# SLACK_BOT_TOKEN=
